{
  "name": "canarinho",
  "version": "0.1.0",
  "private": true,
  "description": "Canarinho 2.0 — portal editorial em monólito modular.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=11.13.0 <12"
  },
  "scripts": {
    "build": "next build",
    "commitlint": "commitlint",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:start:test": "supabase start -x edge-runtime,gotrue,imgproxy,kong,logflare,mailpit,postgres-meta,postgrest,realtime,storage-api,studio,supavisor,vector",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
