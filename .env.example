# Identifica o ambiente logico. Nunca derive autorizacao apenas deste valor.
NEXT_PUBLIC_APP_ENV=local

# URL canonica da aplicacao neste ambiente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Saida de `pnpm db:status` depois de iniciar o Supabase local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_pela_chave_local

# Somente servidor. Deixe vazio enquanto nenhuma operacao privilegiada existir.
# Nunca prefixe este segredo com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Segredos exclusivos da Edge Function communications-worker (configurar no Supabase).
# SITE_URL=https://canarinho.example
# COMMUNICATIONS_CRON_SECRET=gere-um-segredo-longo
# EMAIL_PROVIDER_URL=https://api.provedor.example/emails
# EMAIL_PROVIDER_API_KEY=segredo-do-provedor
# EMAIL_FROM=Canarinho <nao-responda@canarinho.example>
